# Local e2e-suite credentials. Copy to `.env` (gitignored) and fill in.
#
# The key is the PRODUCTION integration key, stored in AWS Secrets Manager at
# `xorgate/integration-test-api-key` in account 865609249890. Read it with:
#
#   AWS_PROFILE=xorgate-prod aws secretsmanager get-secret-value \
#     --secret-id xorgate/integration-test-api-key --query SecretString --output text
#
# Never commit the filled-in file. Never use Alocate's runtime key
# (`alocate/xorgate-api-key`, account 968758165359) here.
XORGATE_API_KEY=xg_...
XORGATE_ORG_ID=cb1e1710-3ee5-49ad-b3d3-32b2290f6e19

# The prod bench device and the workspace it lives in. The e2e suite READS
# from this device and vends workspace-scoped live credentials for it; it
# never writes device config.
XORGATE_TEST_DEVICE_ID=8061fbd7-e5ef-44aa-aff4-18d62244a514
XORGATE_TEST_WORKSPACE_ID=ae1f32f0-6d27-483d-814f-ec5371faa0ea

# Optional. Defaults to https://api.xorgate.io.
# XORGATE_API_URL=https://api.xorgate.io
